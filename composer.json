{
    "name": "zofe/log-module",
    "description": "log module for rapyd-admin application",
    "license": "mit",
    "type": "library",
    "authors": [
        {
            "name": "Felice",
            "email": "felice.ostuni@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/config": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "spatie/laravel-activitylog": "^3.0|^4.0",
        "romanzipp/laravel-queue-monitor": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Log\\": "./",
            "App\\Modules\\Log\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
          "App\\Modules\\Log\\Tests\\": "tests"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit --colors=always",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "App\\Modules\\Log\\LogServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "zofe/rapyd-module-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
